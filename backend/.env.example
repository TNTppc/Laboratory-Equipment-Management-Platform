# Copy values into the shell or a private local environment file. Spring Boot does not auto-load this file.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/lab_manage?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=root
DB_PASSWORD=replace-with-local-mysql-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL_HOURS=12
UPLOAD_DIR=uploads
